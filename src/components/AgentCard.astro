---
import { Image } from 'astro:assets';
import type { Agent } from '../data/agents';
interface Props {
  agent: Agent;
}
const { agent } = Astro.props;
---

<article class:list={['card', { 'card--feature': agent.feature }]}>
  <div class="card-image">
    <Image
      src={agent.image}
      alt=""
      widths={[400, 800]}
      sizes={agent.feature
        ? '(min-width: 1120px) 460px, (min-width: 640px) 45vw, 100vw'
        : '(min-width: 1120px) 360px, (min-width: 640px) 50vw, 100vw'}
      formats={['webp']}
      quality={80}
      loading="lazy"
    />
  </div>
  <div class="card-inner">
    <div class="card-head">
      <span class="card-tag">{agent.tag}</span>
      <h3 class="card-title">
        <a class="card-title-link" href={`/agents/${agent.slug}`}>{agent.name}</a>
      </h3>
    </div>
    <div class="card-body">
      <p class="card-label">こんなお困りごとを解決します</p>
      <p class="card-pain">{agent.pain}</p>
      <p class="card-label">解決できること</p>
      <ul class="card-outcomes">
        {agent.outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </div>
    <a class="card-cta" href={`/agents/${agent.slug}`} aria-label={`${agent.name}の詳細を見る`}>
      詳しく見る <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid rgba(31, 42, 60, 0.08);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* カード見出しのリンク。::after でカード全面を疑似クリック領域にする。
     これで <a> をネストせずにカード全体を遷移対象にできる。 */
  .card-title-link {
    color: inherit;
    transition: color 0.15s ease;
  }
  .card-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card:hover .card-title-link {
    color: var(--color-kincha-dark);
  }

  /* 横長フィーチャーカード：2カラムグリッドを横一杯にぶち抜き、
     画像左・テキスト右の2分割にして「余白の谷」を埋める。
     640px 以下では通常カードと同じ縦積みに戻す。 */
  .card--feature {
    grid-column: 1 / -1;
  }
  @media (min-width: 641px) {
    .card--feature {
      flex-direction: row;
      align-items: stretch;
    }
    .card--feature .card-image {
      aspect-ratio: auto;
      flex: 0 0 42%;
      max-width: 42%;
    }
    .card--feature .card-inner {
      justify-content: center;
    }
  }

  .card-image {
    aspect-ratio: 3 / 2;
    background: var(--color-kinari-deep);
    overflow: hidden;
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    flex: 1;
  }
  .card-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card-tag {
    align-self: flex-start;
    font-family: var(--font-en);
    font-size: var(--font-size-xs);
    color: var(--color-kincha-dark);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card-label {
    font-size: var(--font-size-xs);
    color: var(--color-usuzumi-muted);
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }
  .card-pain {
    font-size: var(--font-size-sm);
    color: var(--color-usuzumi);
    /* 日本語の禁則を厳格適用（小書き仮名・約物を行頭に置かない）。
       text-wrap: pretty で最終行のバランスを取り、一文字だけの行残りを抑える。 */
    line-break: strict;
    text-wrap: pretty;
  }
  .card-outcomes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card-outcomes li {
    position: relative;
    padding-left: 1.25rem;
    font-size: var(--font-size-sm);
    color: var(--color-aizumi);
    line-break: strict;
    text-wrap: pretty;
  }
  .card-outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--color-kincha);
  }
  .card-cta {
    /* 見出しリンクの全面 ::after より前面に出して、
       CTA 自体も独立したクリック対象として機能させる（遷移先は同じ詳細ページ）。 */
    position: relative;
    z-index: 2;
    margin-top: auto;
    font-size: var(--font-size-sm);
    color: var(--color-aizumi);
    border-bottom: 1px solid var(--color-aizumi);
    align-self: flex-start;
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .card-cta:hover {
    color: var(--color-kincha);
    border-color: var(--color-kincha);
  }
</style>
