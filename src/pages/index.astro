---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentCard from '../components/AgentCard.astro';
import LogEntry from '../components/LogEntry.astro';
import { agents } from '../data/agents';
import { logs } from '../data/logs';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">PERSONAL PROJECTS</span>
      <h1 class="hero-title">
        現場の困りごとを、<br />
        <span class="hero-accent">仕組みに変えて、記録に残す。</span>
      </h1>
      <p class="hero-lead">
        独学で、業務を支えるAIエージェントを9つ設計・実装しました。
        作って終わりにせず、動かしながら出た不具合と、その直し方をそのまま記録として残しています。
      </p>
      <div class="hero-cta-row">
        <a href="#team" class="btn-primary">作ったものを見る</a>
        <a href="#log" class="btn-ghost">実装の記録を見る <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="team" class="team">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-eyebrow">WORKS</span>
        <h2 class="section-title">作った仕組み</h2>
        <p class="section-lead">
          業務の困りごとごとに役割を分けて設計した9つのAIエージェント。
          いずれも実際に動かしながら、使いにくいところを直し続けています。
        </p>
      </header>
      <div class="agent-grid">
        {agents.map((agent) => <AgentCard agent={agent} />)}
      </div>
    </div>
  </section>

  <section id="log" class="log-section">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-eyebrow">WORK LOG</span>
        <h2 class="section-title">実装の記録</h2>
        <p class="section-lead">
          うまくいったことより、詰まったことと直し方を残しています。
          同じ失敗を二度繰り返さないための記録です。
        </p>
      </header>
      <div class="log-grid">
        {logs.slice(0, 3).map((log) => <LogEntry log={log} />)}
      </div>
      {logs.length > 3 && (
        <div class="log-more-row">
          <a class="log-more" href="/logs">過去の記録をすべて見る <span aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>

  <section id="about" class="about">
    <div class="section-inner about-inner">
      <header class="section-head">
        <span class="section-eyebrow">ABOUT</span>
        <h2 class="section-title">仕事の進め方</h2>
        <p class="section-lead">
          作るものが何であれ、確かめ方と記録の残し方は同じにしています。
          ここに載せた仕組みは、どれもこのやり方で作りました。
        </p>
      </header>
      <div class="about-grid">
        <div class="about-block">
          <h3 class="about-h3">確かめてから進める</h3>
          <ul class="about-list">
            <li>作った本体とは別に、粗を探す役をもう一つ用意して、二段で確認してから確定する</li>
            <li>「動いた」と「正しい」は分けて扱い、動いたことをもって完了にしない</li>
            <li>結果はURL・時刻・画面の表示を突き合わせてから判断する。見たつもりで語らない</li>
            <li>認証情報は仕組みの外に置く。動かす前に、漏れない形を先に決める</li>
          </ul>
        </div>
        <div class="about-block">
          <h3 class="about-h3">記録を残して、次に使う</h3>
          <ul class="about-list">
            <li>詰まった事象は、原因・切り分け・対処をその日のうちに書き残す</li>
            <li>無言で止まる経路を潰す。動いていないことに気づけない状態を作らない</li>
            <li>直し方は手順の形にして、次に同じことが起きたときに使い回す</li>
          </ul>
        </div>
        <div class="about-block">
          <h3 class="about-h3">使っている技術</h3>
          <ul class="about-list">
            <li>Claude Code を使ったAIエージェントの設計・実装</li>
            <li>Python / TypeScript / Astro / GAS / Vercel</li>
            <li>メール・カレンダー・LINE・表計算との連携と、定期実行の仕組み</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="section-inner">
      <header class="section-head">
        <span class="section-eyebrow">CONTACT</span>
        <h2 class="section-title">連絡先</h2>
        <p class="section-lead">
          このサイトに載せた仕組みや、作った過程についてのお問い合わせはこちらへ。
        </p>
      </header>
      <div class="contact-grid">
        <button
          type="button"
          class="contact-card"
          data-mail-trigger
          data-user="my.biz.official.jp"
          data-domain="gmail.com"
          aria-label="メールで連絡する（メールソフトが開きます）"
        >
          <span class="contact-eyebrow">EMAIL</span>
          <h3 class="contact-h3">メールで連絡する</h3>
          <p class="contact-body">ボタンを押すとメールソフトが開きます</p>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-aizumi) 0%, var(--color-aizumi-deep) 100%);
    color: var(--color-kinari);
    padding: var(--space-7) var(--space-3);
  }
  .hero-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hero-eyebrow {
    font-family: var(--font-en);
    font-size: var(--font-size-xs);
    color: var(--color-kincha-light);
    letter-spacing: 0.15em;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }
  .hero-accent {
    color: var(--color-kincha-light);
  }
  .hero-lead {
    max-width: 640px;
    color: rgba(246, 241, 231, 0.85);
    font-size: var(--font-size-lg);
  }
  .hero-cta-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--color-kincha);
    color: var(--color-aizumi-deep);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 700;
    transition: background 0.15s ease;
  }
  .btn-primary:hover {
    background: var(--color-kincha-light);
  }
  .btn-ghost {
    border: 1px solid rgba(246, 241, 231, 0.4);
    color: var(--color-kinari);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .btn-ghost:hover {
    border-color: var(--color-kincha-light);
    color: var(--color-kincha-light);
  }

  .team,
  .log-section,
  .about,
  .contact {
    padding: var(--space-7) var(--space-3);
  }
  .team {
    background: var(--color-kinari);
  }
  .log-section {
    background: var(--color-kinari-deep);
  }
  .about {
    background: var(--color-aizumi);
    color: var(--color-kinari);
  }
  .contact {
    background: var(--color-kinari);
  }

  .section-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }
  .section-eyebrow {
    font-family: var(--font-en);
    font-size: var(--font-size-xs);
    color: var(--color-kincha-dark);
    letter-spacing: 0.15em;
  }
  .about .section-eyebrow {
    color: var(--color-kincha-light);
  }
  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
  }
  .section-lead {
    color: var(--color-usuzumi);
    max-width: 640px;
  }
  .about .section-lead {
    color: rgba(246, 241, 231, 0.85);
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  @media (max-width: 900px) {
    .agent-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .agent-grid {
      grid-template-columns: 1fr;
    }
  }
  .log-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-3);
  }
  .log-more-row {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }
  .log-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid var(--color-kincha);
    color: var(--color-kincha-dark);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: var(--font-size-sm);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .log-more:hover {
    background: var(--color-kincha);
    color: var(--color-aizumi-deep);
  }

  .about-inner {
    color: var(--color-kinari);
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .about-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about-h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-kincha-light);
  }
  .about-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about-list li {
    position: relative;
    padding-left: 1.25rem;
    color: rgba(246, 241, 231, 0.9);
    font-size: var(--font-size-base);
    line-height: 1.7;
  }
  .about-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--color-kincha-light);
  }
  .inline-link {
    color: var(--color-kincha-light);
    border-bottom: 1px solid var(--color-kincha-light);
    padding-bottom: 1px;
    transition: opacity 0.15s ease;
  }
  .inline-link:hover {
    opacity: 0.8;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-3);
    /* 連絡手段はメール1枚。横幅いっぱいに伸びて間延びしないよう上限を切る */
    max-width: 420px;
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-white);
    border: 1px solid rgba(31, 42, 60, 0.08);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    color: var(--color-aizumi);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .contact-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .contact-eyebrow {
    font-family: var(--font-en);
    font-size: var(--font-size-xs);
    color: var(--color-kincha-dark);
    letter-spacing: 0.12em;
  }
  .contact-h3 {
    font-size: var(--font-size-lg);
    font-weight: 700;
  }
  .contact-body {
    color: var(--color-usuzumi);
    font-size: var(--font-size-sm);
    word-break: break-all;
  }
  .contact-hint {
    margin-top: var(--space-2);
    color: var(--color-aizumi);
    font-size: var(--font-size-sm);
    border-top: 1px solid rgba(31, 42, 60, 0.08);
    padding-top: var(--space-2);
  }

  /* メール相談ボタン：button 要素をカードと同じ見た目に整える */
  button.contact-card {
    appearance: none;
    background: var(--color-white);
    text-align: left;
    width: 100%;
    font: inherit;
  }
</style>

<script>
  // メールアドレスはHTMLソースに平文で置かず、ユーザー名とドメインを
  // data-* に分けて持たせ、クリック時にJSで mailto を組み立てる。
  // （スクレイピングによるアドレス収集対策。アクセシビリティは aria-label で担保）
  const trigger = document.querySelector<HTMLButtonElement>('[data-mail-trigger]');
  trigger?.addEventListener('click', () => {
    const user = trigger.dataset.user ?? '';
    const domain = trigger.dataset.domain ?? '';
    if (!user || !domain) return;
    window.location.href = 'mailto:' + user + '@' + domain;
  });
</script>
