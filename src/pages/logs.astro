---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogAccordion from '../components/LogAccordion.astro';
import { logs } from '../data/logs';

const pageTitle = '実装の記録（アーカイブ）｜個人開発ポートフォリオ';
const pageDescription = '詰まったことと、その直し方の記録。同じ失敗を二度繰り返さないために残した実装記録の全アーカイブ。';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="log-archive">
    <div class="section-inner">
      <a class="back-link" href="/#log">
        <span aria-hidden="true">←</span> トップに戻る
      </a>

      <header class="section-head">
        <span class="section-eyebrow">WORK LOG</span>
        <h1 class="section-title">実装の記録 アーカイブ</h1>
        <p class="section-lead">
          うまくいったことより、詰まったことと直し方を残しています。同じ失敗を二度繰り返さないための記録です。見出しをクリックすると中身が開きます。
        </p>
      </header>

      <div class="log-list">
        {logs.map((log) => <LogAccordion log={log} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .log-archive {
    background: var(--color-kinari-deep);
    padding: var(--space-6) var(--space-3) var(--space-7);
  }
  .section-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-aizumi);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .back-link:hover {
    color: var(--color-kincha);
    border-color: var(--color-kincha);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }
  .section-eyebrow {
    font-family: var(--font-en);
    font-size: var(--font-size-xs);
    color: var(--color-kincha-dark);
    letter-spacing: 0.15em;
  }
  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
  }
  .section-lead {
    color: var(--color-usuzumi);
    max-width: 640px;
  }
  .log-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 760px;
  }
</style>
